APP_NAME="Link Flashcards"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin(s) of the React app allowed by CORS. Separate several with commas.
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite for development (database/database.sqlite).
DB_CONNECTION=sqlite

# MySQL for production:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=link_flashcards
# DB_USERNAME=root
# DB_PASSWORD=

# Scraped pages are cached for 24h. "database" uses the cache table
# created by the migrations; "file" or "redis" also work.
CACHE_STORE=database

# The API is stateless; no sessions or queues are used.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Page fetching.
SCRAPER_TIMEOUT=10
SCRAPER_USER_AGENT="LinkFlashcardsBot/1.0 (+https://github.com/csmaller/coreysmaller; educational quiz generator)"

# PDF uploads. PHP's upload_max_filesize/post_max_size must allow at least
# PDF_MAX_KB; `composer serve` loads php/uploads.ini for that.
PDF_MAX_KB=12288
PDF_MAX_PAGES=300
